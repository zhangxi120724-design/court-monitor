PERFECTGYM_BASE_URL=https://thekallang.perfectgym.com/clientportal2/#/FacilityBooking?clubId=1&zoneTypeId=85
PERFECTGYM_LOGIN_URL=https://thekallang.perfectgym.com/clientportal2/

# Fill either TARGET_DATE or TARGET_OFFSET_DAYS.
# Examples:
# TARGET_DATE=2026-04-30
# TARGET_OFFSET_DAYS=7
TARGET_DATE=
TARGET_OFFSET_DAYS=

# Time and court matching are fuzzy contains matches.
TARGET_TIME_TEXT=19:00
TARGET_COURT_KEYWORD=indoor

# Optional login credentials.
PERFECTGYM_EMAIL=
PERFECTGYM_PASSWORD=

# When true, the browser stays visible.
HEADLESS=false

# Retry interval in milliseconds while polling for slots.
POLL_INTERVAL_MS=1500

# Total polling time in milliseconds before giving up.
MAX_WAIT_MS=120000
