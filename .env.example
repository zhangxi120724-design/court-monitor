PERFECTGYM_BASE_URL=https://thekallang.perfectgym.com/clientportal2/#/FacilityBooking?clubId=1&zoneTypeId=85
PERFECTGYM_LOGIN_URL=https://thekallang.perfectgym.com/clientportal2/

# Optional explicit booking pages.
# If left blank, they are derived from PERFECTGYM_BASE_URL:
# indoor -> zoneTypeId=85
# outdoor -> zoneTypeId=83
INDOOR_BOOKING_URL=
OUTDOOR_BOOKING_URL=

# Fill either TARGET_DATE or TARGET_OFFSET_DAYS.
# Examples:
# TARGET_DATE=2026-04-30
# TARGET_OFFSET_DAYS=7
TARGET_DATE=
TARGET_OFFSET_DAYS=7

# Slot matching.
TARGET_TIME_TEXT=20:00

# Optional extra text filter. Leave blank for the default indoor -> outdoor fallback flow.
TARGET_COURT_KEYWORD=

# Fallback order:
# 1. indoor tab first
# 2. outdoor tab next, only courts 8-15
ENABLE_OUTDOOR_FALLBACK=true
OUTDOOR_COURT_PRIORITY=8-15

# Prefer 120 minutes first, then 60 minutes if the next hour is not available.
BOOKING_DURATION_PRIORITY=120,60

# Optional login credentials.
PERFECTGYM_EMAIL=
PERFECTGYM_PASSWORD=

# When true, the browser stays visible.
HEADLESS=false

# Refresh exactly at opening time in short, limited bursts.
# This is the primary knob for reducing risk.
REFRESH_ATTEMPTS=4
REFRESH_SPACING_MS=100

# Direct API only: start polling this many milliseconds before BOOKING_START_AT.
# Use with REFRESH_ATTEMPTS/REFRESH_SPACING_MS so an early miss can still retry.
DIRECT_API_EARLY_MS=0

# Direct API only: how many court schedules to check in parallel per attempt.
DIRECT_API_WORKERS=1

# Optional timed start for抢场地.
# Supported formats:
# BOOKING_START_AT=2026-04-27T09:00:00+08:00
# BOOKING_START_AT=2026-04-27 09:00:00
BOOKING_START_AT=
BOOKING_TIMEZONE=Asia/Singapore

# When true and BOOKING_START_AT is empty, the script auto-derives the opening time
# as TARGET_DATE at TARGET_TIME_TEXT minus BOOKING_OPEN_LEAD_DAYS.
AUTO_BOOKING_WINDOW=true
BOOKING_OPEN_LEAD_DAYS=7

# Open browser and finish login this many seconds before BOOKING_START_AT.
BOOKING_PREPARE_SECONDS=90

# How long to wait for manual login before failing.
MANUAL_LOGIN_TIMEOUT_SECONDS=300

# Optional: bypass browser UI and book through PerfectGym API using .auth/storage-state.json.
DIRECT_API=false

# Optional: write captured PerfectGym API requests/responses as JSONL.
# This file may contain cookies/tokens. Keep it inside .auth/ and do not share it.
NETWORK_CAPTURE_PATH=
NETWORK_CAPTURE_BODY_LIMIT=20000
