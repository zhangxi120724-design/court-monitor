# ============================================
# PerfectGym 配置（必需）
# ============================================
PERFECTGYM_BASE_URL=https://thekallang.perfectgym.com/clientportal2/#/FacilityBooking?clubId=1
PERFECTGYM_EMAIL=your-email@example.com
PERFECTGYM_PASSWORD=your-password

# ============================================
# Telegram 通知配置（必需）
# ============================================

# Telegram Bot Token
# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram Chat ID
# 发消息给 bot，然后访问 https://api.telegram.org/bot<TOKEN>/getUpdates 获取
TELEGRAM_CHAT_ID=5751483301

# ============================================
# 监听配置（可选）
# ============================================

# 检查间隔（分钟）
# 1 = 每分钟检查一次（实时监听）
# 2 = 每 2 分钟检查一次（平衡实时性和成本）
# 5 = 每 5 分钟检查一次
MONITOR_CHECK_INTERVAL_MINS=1

# 时区
BOOKING_TIMEZONE=Asia/Singapore

# ============================================
# 时间窗口配置（可选）
# ============================================

# 工作日（周一至周五）的监听时间
# 默认：20（8pm）到 22（10pm）
MONITOR_WEEKDAY_START_HOUR=20
MONITOR_WEEKDAY_END_HOUR=22

# 周末（周六、日）的监听时间
# 默认：17（5pm）到 22（10pm）
MONITOR_WEEKEND_START_HOUR=17
MONITOR_WEEKEND_END_HOUR=22

# ============================================
# 场地优先级配置（可选）
# ============================================

# 优先级：Indoor > Outdoor
# Indoor：1-7 号场（zoneTypeId=85）
# Outdoor：8-15 号场（zoneTypeId=83）
OUTDOOR_COURT_PRIORITY=8-15
BOOKING_DURATION_PRIORITY=120,60

# ============================================
# Direct API 配置（可选）
# ============================================

# 使用 Direct API 模式加速检查
DIRECT_API=true

# Direct API 工作线程数（并发检查场地数）
DIRECT_API_WORKERS=2
